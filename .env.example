# ---------------------------------------------------------------------------
# What the portal reads. Only DATABASE_URL is required; OWNER_EMAIL is how the
# first account gets created.
# ---------------------------------------------------------------------------

# TiDB Cloud Serverless. Port is 4000 (not 3306) and TLS is mandatory —
# without it TiDB answers "1105: Connections using insecure transport are
# prohibited". Keep ?sslaccept=strict on the end; if it is missing from a
# tidbcloud.com URL the portal appends it (see src/lib/database-url.ts).
# Copy this from the TiDB Cloud console:
#   Cluster -> Connect -> Connect With -> Prisma
DATABASE_URL="mysql://USER.root:PASSWORD@gateway01.REGION.prod.aws.tidbcloud.com:4000/hackathon_studio?sslaccept=strict"

# Generate once with:  openssl rand -base64 32
# Used for CSRF tokens and cookie integrity. Sessions do NOT depend on it, so
# rotating this will not sign anybody out.
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# The first account. Set it before the first deploy: when the database is empty
# the bootstrap seeds a T4 owner invite and prints the link — in the Render
# deploy log if you are on the free plan, which has no Shell. Safe to remove
# once somebody has signed in.
OWNER_EMAIL="you@kmids.ac.th"

# Optional. Sign-in is limited to @kmids.ac.th unless this says otherwise —
# useful only if the school addresses are not handed out yet.
# ALLOWED_EMAIL_DOMAIN="kmids.ac.th"

# Optional. Set to the portal's public URL once you have one.
# APP_URL="https://hackathon-studio.onrender.com"
