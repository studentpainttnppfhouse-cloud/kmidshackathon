// KMIDS Hackathon 2027 — Staff Portal ("Hackathon Studio")
// Target: TiDB Cloud Serverless (MySQL protocol, port 4000, TLS required).
//
// relationMode = "prisma" because TiDB does not enforce foreign keys the way
// MySQL does in every configuration. Referential integrity is enforced by the
// application, not the database. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Permission tiers are cumulative: each tier includes everything below it.
enum Tier {
  T0_ADVISOR
  T1_MEMBER
  T2_HEAD
  T3_ADMIN
  T4_OWNER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? @db.VarChar(255)

  name      String
  nickname  String?
  grade     String?
  phone     String?
  lineId    String?
  avatarUrl String? @db.Text
  shirtSize String?
  roleTitle String?

  tier         Tier    @default(T1_MEMBER)
  departmentId String?

  isReserve Boolean @default(false)
  isMentor  Boolean @default(false)
  isAlumni  Boolean @default(false)
  isActive  Boolean @default(true)

  // Login throttling — 5 failures locks the account for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  profileCompletedAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  headOf            Department[]         @relation("DepartmentHead")
  sessions          Session[]
  passwordResets    PasswordReset[]
  invitesSent       Invite[]             @relation("InviteInvitedBy")
  assignmentsMade   Assignment[]         @relation("AssignmentCreatedBy")
  assignmentsOwned  AssignmentAssignee[]
  comments          Comment[]
  documents         Document[]
  files             FileAsset[]
  forms             Form[]
  formResponses     FormResponse[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  checkins          Checkin[]
  incidents         Incident[]
  auditEntries      AuditLog[]

  @@index([departmentId])
  @@index([tier])
  @@map("users")
}

/// Opaque, database-backed sessions.
///
/// The cookie carries a random 32-byte token; only its SHA-256 hash is stored.
/// Nothing about the session depends on an application secret, so a redeploy —
/// or even a rotated AUTH_SECRET — cannot log anybody out. This is what makes
/// "sign in once" true across updates.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?   @db.Text
  ip         String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invite {
  id           String    @id @default(cuid())
  email        String
  code         String    @unique @db.VarChar(64)
  tier         Tier      @default(T1_MEMBER)
  departmentId String?
  name         String?
  roleTitle    String?
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  invitedBy  User        @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([invitedById])
  @@index([departmentId])
  @@map("invites")
}

/// Admin-issued only. No email service is part of this deployment: T4 generates
/// the link in the admin panel and hands it to the person directly.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  code       String    @unique @db.VarChar(64)
  issuedById String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  color       String  @default("#EC4899")
  icon        String?
  headUserId  String?
  sortOrder   Int     @default(0)
  isGeneral   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head          User?          @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       User[]         @relation("DepartmentMembers")
  invites       Invite[]
  assignments   Assignment[]
  documents     Document[]
  files         FileAsset[]
  forms         Form[]
  announcements Announcement[]

  @@index([headUserId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Assignments — the core module
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_REVIEW
  APPROVED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Assignment {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  departmentId String
  createdById  String
  dueDate      DateTime?
  priority     Priority         @default(MEDIUM)
  status       AssignmentStatus @default(NOT_STARTED)
  approvedById String?
  approvedAt   DateTime?
  linkUrl      String?          @db.Text
  recurrence   String?
  year         Int              @default(2027)
  sortOrder    Int              @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department           @relation(fields: [departmentId], references: [id])
  createdBy  User                 @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  assignees  AssignmentAssignee[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([year])
  @@map("assignments")
}

model AssignmentAssignee {
  assignmentId String
  userId       String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@id([assignmentId, userId])
  @@index([userId])
  @@map("assignment_assignees")
}

/// Polymorphic by design: comments hang off assignments, documents, incidents.
/// TiDB has no cross-table FK enforcement anyway, so a discriminator column is
/// no weaker here than a real relation would be.
model Comment {
  id         String    @id @default(cuid())
  parentType String    @db.VarChar(32)
  parentId   String
  userId     String
  body       String    @db.Text
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([parentType, parentId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

/// A document is either a link to something in Google Drive, or a document
/// written in the portal itself. `source` says which, and exactly one of
/// `externalUrl` / `body` is meaningful for a given row.
model Document {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  departmentId String
  ownerId      String
  /// Set for source = "external". Null for documents written in the portal.
  externalUrl  String?   @db.Text
  /// "external" (a Drive link) or "portal" (written here, body below).
  source       String    @default("external") @db.VarChar(16)
  /// Markdown body for source = "portal". Never rendered as raw HTML.
  body         String?   @db.LongText
  /// Optional attachment to a task, so a submission is the document itself.
  assignmentId String?
  status       DocStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  tags         Json?
  year         Int       @default(2027)
  /// Incremented on every save. The number a reader sees, and the number the
  /// next revision row is filed under.
  version      Int       @default(1)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department         @relation(fields: [departmentId], references: [id])
  owner      User               @relation(fields: [ownerId], references: [id])
  revisions  DocumentRevision[]

  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
  @@index([year])
  @@index([assignmentId])
  @@map("documents")
}

/// What a document said before somebody changed it.
///
/// A member editing a shared plan and pasting over three weeks of work is the
/// failure this table exists for. Every save writes the *previous* state here
/// first, so the current row is never the only copy and any earlier version can
/// be put back. Restoring is itself a save, so undoing a restore works too.
model DocumentRevision {
  id          String    @id @default(cuid())
  documentId  String
  /// The version number this snapshot holds — document.version at the time.
  version     Int
  title       String
  description String?   @db.Text
  source      String    @default("external") @db.VarChar(16)
  externalUrl String?   @db.Text
  body        String?   @db.LongText
  status      DocStatus @default(DRAFT)
  /// Who made the edit that displaced this version. Null once they are removed.
  editedById  String?
  /// "edit" or "restore" — what displaced this version.
  reason      String    @default("edit") @db.VarChar(16)
  createdAt   DateTime  @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([documentId, version])
  @@index([documentId])
  @@index([editedById])
  @@map("document_revisions")
}

/// An asset is either a link to something in Drive/Canva, or a file whose bytes
/// live in TiDB. `storage` says which.
///
/// Render's disk is wiped on every deploy, so an uploaded file cannot be kept
/// on the instance — but the database outlives every deploy, which is why the
/// bytes go there instead. They are split into `FileChunk` rows rather than one
/// giant column: TiDB rejects a single transaction entry over ~6 MB, so a
/// 20 MB poster written as one row would fail on insert and a 20 MB row read
/// back in one piece would spike memory on a 512 MB Render instance.
model FileAsset {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  /// Set for storage = "link". Null for files stored in the database.
  externalUrl String? @db.Text
  /// "link" (bytes elsewhere) or "db" (bytes in file_chunks).
  storage     String  @default("link") @db.VarChar(16)
  /// The name the file had on the uploader's machine, so a download keeps its
  /// extension even when the asset is titled "Poster template A3".
  fileName    String? @db.VarChar(255)
  /// Declared content type, kept only for files stored here.
  mimeType    String? @db.VarChar(160)
  /// Total size in bytes, so the quota can be checked without reading chunks.
  sizeBytes   Int?
  /// SHA-256 of the stored bytes — the download ETag, and proof of integrity.
  checksum    String? @db.VarChar(64)

  kind         String  @default("link")
  departmentId String
  uploadedById String
  tags         Json?
  isBrandKit   Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department  @relation(fields: [departmentId], references: [id])
  uploadedBy User        @relation(fields: [uploadedById], references: [id])
  chunks     FileChunk[]

  @@index([departmentId])
  @@index([uploadedById])
  @@index([isBrandKit])
  @@index([storage])
  @@map("files")
}

/// One slice of an uploaded file, in order. See `FileAsset` for why.
model FileChunk {
  fileId String
  idx    Int
  bytes  Bytes @db.MediumBlob

  file FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([fileId, idx])
  @@map("file_chunks")
}

model Form {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  type          String    @default("external")
  url           String?   @db.Text
  slug          String?   @unique
  schema        Json?
  ownerId       String
  departmentId  String?
  deadline      DateTime?
  responseCount Int       @default(0)
  responseUrl   String?   @db.Text
  isOpen        Boolean   @default(true)
  year          Int       @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  responses  FormResponse[]

  @@index([ownerId])
  @@index([departmentId])
  @@map("forms")
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String?
  payload     Json
  submittedAt DateTime @default(now())

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([formId])
  @@index([userId])
  @@map("form_responses")
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

model Announcement {
  id           String  @id @default(cuid())
  title        String
  body         String  @db.Text
  scope        String  @default("all")
  departmentId String?
  authorId     String
  pinned       Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author     User               @relation(fields: [authorId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  reads      AnnouncementRead[]

  @@index([authorId])
  @@index([departmentId])
  @@index([pinned])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ---------------------------------------------------------------------------
// Event day
// ---------------------------------------------------------------------------

model EventItem {
  id        String  @id @default(cuid())
  day       String
  startTime String
  endTime   String?
  title     String
  location  String?
  notes     String? @db.Text
  ownerId   String?
  sortOrder Int     @default(0)
  year      Int     @default(2027)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([year])
  @@map("event_items")
}

model Checkin {
  id           String    @id @default(cuid())
  userId       String
  day          String
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([day])
  @@map("checkins")
}

model Incident {
  id           String    @id @default(cuid())
  reportedById String
  occurredAt   DateTime  @default(now())
  severity     String    @default("low")
  description  String    @db.Text
  location     String?
  resolution   String?   @db.Text
  resolvedAt   DateTime?
  year         Int       @default(2027)

  reportedBy User @relation(fields: [reportedById], references: [id])

  @@index([reportedById])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(32)
  targetId   String?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

/// The brand kit, as data rather than a hard-coded array.
///
/// Colours and fonts were a constant in the source, which meant every tweak was
/// a redeploy and nobody outside the repository could make one. They live here
/// so a T3 can add the twentieth shade of pink from the portal itself, and so
/// the Brand Kit export has something real to read.
model BrandToken {
  id          String   @id @default(cuid())
  /// "color" or "font".
  kind        String   @default("color") @db.VarChar(16)
  name        String
  /// A #RRGGBB hex for a colour; a CSS font stack for a font.
  value       String   @db.Text
  /// Free-text grouping — "Primary", "Neutrals", "Headings".
  groupName   String?  @db.VarChar(60)
  note        String?  @db.Text
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([sortOrder])
  @@map("brand_tokens")
}

/// Single-row key/value table for portal-wide switches (archive mode,
/// event-day mode, the countdown target).
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}
