// KMIDS Hackathon 2027 — Staff Portal ("Hackathon Studio")
// Target: TiDB Cloud Serverless (MySQL protocol, port 4000, TLS required).
//
// relationMode = "prisma" because TiDB does not enforce foreign keys the way
// MySQL does in every configuration. Referential integrity is enforced by the
// application, not the database. See docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Permission tiers are cumulative: each tier includes everything below it.
enum Tier {
  T0_ADVISOR
  T1_MEMBER
  T2_HEAD
  T3_ADMIN
  T4_OWNER
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String? @db.VarChar(255)

  name      String
  nickname  String?
  grade     String?
  phone     String?
  lineId    String?
  avatarUrl String? @db.Text
  shirtSize String?
  roleTitle String?

  tier         Tier    @default(T1_MEMBER)
  departmentId String?

  /// Set when the account was created by scanning or opening a join link.
  joinedViaLinkId String?

  isReserve Boolean @default(false)
  isMentor  Boolean @default(false)
  isAlumni  Boolean @default(false)
  isActive  Boolean @default(true)

  // Login throttling — 5 failures locks the account for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  profileCompletedAt DateTime?
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  department Department? @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  headOf            Department[]         @relation("DepartmentHead")
  sessions          Session[]
  passwordResets    PasswordReset[]
  invitesSent       Invite[]             @relation("InviteInvitedBy")
  inviteLinks       InviteLink[]         @relation("InviteLinkCreatedBy")
  joinedVia         InviteLink?          @relation("InviteLinkJoiners", fields: [joinedViaLinkId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  attachments       Attachment[]
  assignmentsMade   Assignment[]         @relation("AssignmentCreatedBy")
  assignmentsOwned  AssignmentAssignee[]
  comments          Comment[]
  documents         Document[]
  files             FileAsset[]
  forms             Form[]
  formResponses     FormResponse[]
  announcements     Announcement[]
  announcementReads AnnouncementRead[]
  checkins          Checkin[]
  incidents         Incident[]
  auditEntries      AuditLog[]

  @@index([departmentId])
  @@index([tier])
  @@index([joinedViaLinkId])
  @@map("users")
}

/// Opaque, database-backed sessions.
///
/// The cookie carries a random 32-byte token; only its SHA-256 hash is stored.
/// Nothing about the session depends on an application secret, so a redeploy —
/// or even a rotated AUTH_SECRET — cannot log anybody out. This is what makes
/// "sign in once" true across updates.
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userAgent  String?   @db.Text
  ip         String?
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Invite {
  id           String    @id @default(cuid())
  email        String
  code         String    @unique @db.VarChar(64)
  tier         Tier      @default(T1_MEMBER)
  departmentId String?
  name         String?
  roleTitle    String?
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  invitedBy  User        @relation("InviteInvitedBy", fields: [invitedById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([email])
  @@index([invitedById])
  @@index([departmentId])
  @@map("invites")
}

/// Admin-issued only. No email service is part of this deployment: T4 generates
/// the link in the admin panel and hands it to the person directly.
model PasswordReset {
  id         String    @id @default(cuid())
  userId     String
  code       String    @unique @db.VarChar(64)
  issuedById String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_resets")
}

// ---------------------------------------------------------------------------
// Structure
// ---------------------------------------------------------------------------

model Department {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String? @db.Text
  color       String  @default("#EC4899")
  icon        String?
  headUserId  String?
  sortOrder   Int     @default(0)
  isGeneral   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  head          User?          @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  members       User[]         @relation("DepartmentMembers")
  invites       Invite[]
  inviteLinks   InviteLink[]
  attachments   Attachment[]
  assignments   Assignment[]
  documents     Document[]
  files         FileAsset[]
  forms         Form[]
  announcements Announcement[]

  @@index([headUserId])
  @@map("departments")
}

// ---------------------------------------------------------------------------
// Assignments — the core module
// ---------------------------------------------------------------------------

enum AssignmentStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_REVIEW
  APPROVED
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Assignment {
  id           String           @id @default(cuid())
  title        String
  description  String?          @db.Text
  departmentId String
  createdById  String
  dueDate      DateTime?
  priority     Priority         @default(MEDIUM)
  status       AssignmentStatus @default(NOT_STARTED)
  approvedById String?
  approvedAt   DateTime?
  linkUrl      String?          @db.Text
  recurrence   String?
  year         Int              @default(2027)
  sortOrder    Int              @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department           @relation(fields: [departmentId], references: [id])
  createdBy  User                 @relation("AssignmentCreatedBy", fields: [createdById], references: [id])
  assignees  AssignmentAssignee[]

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([dueDate])
  @@index([year])
  @@map("assignments")
}

model AssignmentAssignee {
  assignmentId String
  userId       String
  createdAt    DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@id([assignmentId, userId])
  @@index([userId])
  @@map("assignment_assignees")
}

/// Polymorphic by design: comments hang off assignments, documents, incidents.
/// TiDB has no cross-table FK enforcement anyway, so a discriminator column is
/// no weaker here than a real relation would be.
model Comment {
  id         String    @id @default(cuid())
  parentType String    @db.VarChar(32)
  parentId   String
  userId     String
  body       String    @db.Text
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([parentType, parentId])
  @@index([userId])
  @@map("comments")
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

enum DocStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

/// A document is either a link to something in Google Drive, or a document
/// written in the portal itself. `source` says which, and exactly one of
/// `externalUrl` / `body` is meaningful for a given row.
model Document {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  departmentId String
  ownerId      String
  /// Set for source = "external". Null for documents written in the portal.
  externalUrl  String?   @db.Text
  /// "external" (a Drive link) or "portal" (written here, body below).
  source       String    @default("external") @db.VarChar(16)
  /// Markdown body for source = "portal". Never rendered as raw HTML.
  body         String?   @db.LongText
  /// Optional attachment to a task, so a submission is the document itself.
  assignmentId String?
  status       DocStatus @default(DRAFT)
  approvedById String?
  approvedAt   DateTime?
  tags         Json?
  year         Int       @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  owner      User       @relation(fields: [ownerId], references: [id])

  @@index([departmentId])
  @@index([ownerId])
  @@index([status])
  @@index([year])
  @@index([assignmentId])
  @@map("documents")
}

model FileAsset {
  id           String  @id @default(cuid())
  name         String
  description  String? @db.Text
  /// Set for kind = "link". Null for an asset uploaded into the portal, whose
  /// bytes are an Attachment with parentType = "file" and parentId = this id.
  externalUrl  String? @db.Text
  kind         String  @default("link")
  departmentId String
  uploadedById String
  tags         Json?
  isBrandKit   Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [id])
  uploadedBy User       @relation(fields: [uploadedById], references: [id])

  @@index([departmentId])
  @@index([uploadedById])
  @@index([isBrandKit])
  @@map("files")
}

model Form {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  type          String    @default("external")
  url           String?   @db.Text
  slug          String?   @unique
  schema        Json?
  ownerId       String
  departmentId  String?
  deadline      DateTime?
  responseCount Int       @default(0)
  responseUrl   String?   @db.Text
  isOpen        Boolean   @default(true)
  year          Int       @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  owner      User           @relation(fields: [ownerId], references: [id])
  department Department?    @relation(fields: [departmentId], references: [id])
  responses  FormResponse[]

  @@index([ownerId])
  @@index([departmentId])
  @@map("forms")
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String?
  payload     Json
  submittedAt DateTime @default(now())

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([formId])
  @@index([userId])
  @@map("form_responses")
}

// ---------------------------------------------------------------------------
// Announcements
// ---------------------------------------------------------------------------

model Announcement {
  id           String  @id @default(cuid())
  title        String
  body         String  @db.Text
  scope        String  @default("all")
  departmentId String?
  authorId     String
  pinned       Boolean @default(false)
  year         Int     @default(2027)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  author     User               @relation(fields: [authorId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  reads      AnnouncementRead[]

  @@index([authorId])
  @@index([departmentId])
  @@index([pinned])
  @@map("announcements")
}

model AnnouncementRead {
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_reads")
}

// ---------------------------------------------------------------------------
// Event day
// ---------------------------------------------------------------------------

model EventItem {
  id        String  @id @default(cuid())
  day       String
  startTime String
  endTime   String?
  title     String
  location  String?
  notes     String? @db.Text
  ownerId   String?
  sortOrder Int     @default(0)
  year      Int     @default(2027)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([day])
  @@index([year])
  @@map("event_items")
}

model Checkin {
  id           String    @id @default(cuid())
  userId       String
  day          String
  checkedInAt  DateTime  @default(now())
  checkedOutAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([day])
  @@map("checkins")
}

model Incident {
  id           String    @id @default(cuid())
  reportedById String
  occurredAt   DateTime  @default(now())
  severity     String    @default("low")
  description  String    @db.Text
  location     String?
  resolution   String?   @db.Text
  resolvedAt   DateTime?
  year         Int       @default(2027)

  reportedBy User @relation(fields: [reportedById], references: [id])

  @@index([reportedById])
  @@map("incidents")
}

// ---------------------------------------------------------------------------
// Ops
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(64)
  targetType String?  @db.VarChar(32)
  targetId   String?
  detail     String?  @db.Text
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

/// The brand kit, as data rather than a hard-coded array.
///
/// Colours and fonts were a constant in the source, which meant every tweak was
/// a redeploy and nobody outside the repository could make one. They live here
/// so a T3 can add the twentieth shade of pink from the portal itself, and so
/// the Brand Kit export has something real to read.
model BrandToken {
  id          String   @id @default(cuid())
  /// "color" or "font".
  kind        String   @default("color") @db.VarChar(16)
  name        String
  /// A #RRGGBB hex for a colour; a CSS font stack for a font.
  value       String   @db.Text
  /// Free-text grouping — "Primary", "Neutrals", "Headings".
  groupName   String?  @db.VarChar(60)
  note        String?  @db.Text
  sortOrder   Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind])
  @@index([sortOrder])
  @@map("brand_tokens")
}

/// Single-row key/value table for portal-wide switches (archive mode,
/// event-day mode, the countdown target).
model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("settings")
}

// ---------------------------------------------------------------------------
// Join links — the organisation invite, the way Teams does it
// ---------------------------------------------------------------------------

/// One link the whole team can use, instead of one invite per person.
///
/// The per-email `Invite` above still exists and is still the precise tool: it
/// names one address and burns itself on first use. A join link is the other
/// half — the thing you print on a poster, paste in the LINE group, or put on
/// a slide at the first staff meeting so sixty people register themselves in
/// the five minutes you have their attention.
///
/// What keeps it from being an open sign-up page:
///
///   - the email domain is still enforced, so only @kmids.ac.th can register;
///   - the tier it grants is capped (see JOIN_LINK_MAX_TIER) — a self-serve
///     link can never mint an admin, whoever gets hold of it;
///   - uses, expiry and revocation are all first-class, so a leaked link is a
///     link you switch off;
///   - `users.joinedViaLinkId` records which link an account came through, so
///     a bad one can be traced after the fact rather than guessed at.
model InviteLink {
  id    String @id @default(cuid())
  code  String @unique @db.VarChar(64)
  /// What the link is for, in the admin list: "Staff meeting poster", "LINE".
  label String

  tier         Tier    @default(T1_MEMBER)
  departmentId String?
  roleTitle    String?

  createdById String
  /// Null means unlimited. A number is a hard ceiling, checked on every use.
  maxUses     Int?
  useCount    Int    @default(0)

  /// Null means it never expires on its own.
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  createdBy  User        @relation("InviteLinkCreatedBy", fields: [createdById], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  joiners    User[]      @relation("InviteLinkJoiners")

  @@index([createdById])
  @@index([departmentId])
  @@map("invite_links")
}

// ---------------------------------------------------------------------------
// Attachments — files, in the database, revising decision D2-1
// ---------------------------------------------------------------------------

/// A file somebody attached, wherever they attached it.
///
/// The original design stored links only, because Render wipes its disk on
/// every deploy and "upload" therefore meant "lose it next Tuesday". That
/// reasoning was about the *disk*. The database is not the disk: TiDB survives
/// every redeploy the disk does not, so the bytes go there instead, in
/// `attachment_chunks`, and a file attached from a phone at the back of a
/// classroom is still there after the next deploy.
///
/// Two storage modes, chosen by size rather than by the person uploading:
///
///   "db"   — the bytes are in attachment_chunks. Anything up to the limit in
///            src/lib/attachments.ts.
///   "link" — over the limit. The row keeps the name and the URL of wherever
///            the file actually lives, so a 400MB export video is still
///            findable from the task it belongs to.
///
/// `parentType` + `parentId` are polymorphic for the same reason `comments`
/// are: TiDB enforces no foreign keys here anyway, so a discriminator column
/// costs nothing a real relation would have given us. Permission is never
/// stored on the attachment — it is always re-derived from the parent, so a
/// task that moves department takes its files with it.
model Attachment {
  id         String @id @default(cuid())
  parentType String @db.VarChar(32)
  parentId   String

  name     String @db.VarChar(255)
  /// Sanitised on the way in; see safeMimeType(). Never trusted from the browser.
  mimeType String @db.VarChar(120)
  size     Int
  /// SHA-256 of the bytes. Lets a re-upload be spotted, and a download verified.
  checksum String @default("") @db.VarChar(64)

  /// "db" or "link".
  storage     String  @default("db") @db.VarChar(8)
  externalUrl String? @db.Text

  /// Copied from the parent at upload time, for the department filter only.
  departmentId String?
  uploadedById String

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  uploadedBy User              @relation(fields: [uploadedById], references: [id])
  department Department?       @relation(fields: [departmentId], references: [id])
  chunks     AttachmentChunk[]

  @@index([parentType, parentId])
  @@index([uploadedById])
  @@index([departmentId])
  @@map("attachments")
}

/// The bytes, split up.
///
/// One row per 256 KB. TiDB caps the size of a single transaction entry, and a
/// 10 MB LONGBLOB in one row is a row every `SELECT *` on the table has to drag
/// through the network — so the file is written in pieces and streamed back the
/// same way, one chunk in memory at a time rather than the whole thing.
model AttachmentChunk {
  id           String @id @default(cuid())
  attachmentId String
  idx          Int
  bytes        Bytes  @db.MediumBlob

  attachment Attachment @relation(fields: [attachmentId], references: [id])

  @@unique([attachmentId, idx])
  @@map("attachment_chunks")
}
